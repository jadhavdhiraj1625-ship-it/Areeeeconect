# AgriConnect Backend Environment Variables (Render / Production)

# Server Port (Render automatically sets process.env.PORT)
PORT=5000

# Node Environment (production / development)
NODE_ENV=production

# MongoDB Atlas Production Connection String
# Single source of truth: Areeconnect_database
# Format: mongodb+srv://<username>:<password>@cluster0.0qqka4s.mongodb.net/Areeconnect_database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.0qqka4s.mongodb.net/Areeconnect_database?retryWrites=true&w=majority

# JWT Secret Key for Cryptographic Token Signing
JWT_SECRET=your_production_jwt_secret_key_change_me_2026

# Token Lifetime
JWT_EXPIRES_IN=7d

# Production Frontend URL (Your Vercel Deployment Domain)
# Example: https://agriconnect.vercel.app (or comma-separated for multiple domains)
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app
